{
  "name": "Booking",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "price": {
      "type": "number"
    },
    "warranty": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "customer_name",
    "service",
    "date"
  ]
}